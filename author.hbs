{{!< default}}

{{#author}}
    <header class="archive-head">
        <p class="archive-label">Author</p>
        <h1 class="archive-title">{{name}}</h1>
        {{#if bio}}<p class="archive-desc">{{bio}}</p>{{/if}}
    </header>
{{/author}}

<section class="sheet">
    {{#foreach posts}}
        {{> "post-card"}}
    {{/foreach}}
</section>

{{pagination}}
