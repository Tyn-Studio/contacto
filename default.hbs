<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <script>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{ghost_head}}
</head>

<body class="{{body_class}}">
    <a class="skip-link" href="#site-main">Skip to content</a>

    <header class="site-head">
        <a class="site-name" href="{{@site.url}}">{{@site.title}}</a>
        <nav class="site-nav" id="site-nav">
            {{navigation}}
        </nav>
        {{#if @member}}
            <a class="head-cta" href="#/portal/account" data-portal="account">Account</a>
        {{else}}
            <a class="head-cta" href="#/portal/signin" data-portal="signin">Sign in</a>
        {{/if}}
        <button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button>
    </header>

    <main id="site-main" class="site-main">
        {{{body}}}
    </main>

    <footer class="site-foot">
        <div class="foot-line">
            <span class="foot-copy">&copy; {{date format="YYYY"}} {{@site.title}}</span>
            <span class="foot-links">
                {{#if @site.facebook}}<a href="{{social_url type="facebook"}}" rel="me">Facebook</a>{{/if}}
                {{#if @site.twitter}}<a href="{{social_url type="twitter"}}" rel="me">Twitter</a>{{/if}}
                <a href="{{@site.url}}/rss/">RSS</a>
            </span>
        </div>
    </footer>

    {{#unless @custom.disable_lightbox}}
        <script defer src="{{asset "js/main.js"}}"></script>
    {{/unless}}
    {{#is "page"}}
        <script defer src="{{asset "js/gallery.js"}}"></script>
    {{/is}}
    <script>(function () {
    var head = document.querySelector('.site-head');
    var toggle = head && head.querySelector('.menu-toggle');
    if (!toggle) return;
    function set(open) {
        head.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () { set(!head.classList.contains('is-open')); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    document.addEventListener('click', function (e) { if (!head.contains(e.target)) set(false); });
})();</script>
    {{ghost_foot}}
</body>

</html>
