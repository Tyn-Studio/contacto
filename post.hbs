{{!< default}}

{{#post}}
    <article class="post {{post_class}}">
        <header class="post-head">
            <h1 class="post-title">{{title}}</h1>
            <p class="post-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                <span aria-hidden="true">&middot;</span>
                {{reading_time}}
                {{#if primary_tag}}
                    <span aria-hidden="true">&middot;</span>
                    <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                {{/if}}
            </p>
        </header>

        {{#if feature_image}}
            <figure class="post-feature">
                <img srcset="{{img_url feature_image size="m"}} 800w,
                            {{img_url feature_image size="l"}} 1200w,
                            {{img_url feature_image size="xl"}} 2000w"
                    sizes="(min-width: 1100px) 1040px, 100vw"
                    src="{{img_url feature_image size="l"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="eager" fetchpriority="high">
                {{#if feature_image_caption}}
                    <figcaption>{{{feature_image_caption}}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}

        <section class="post-content gh-content">
            {{content}}
        </section>
    </article>

    {{#unless @member}}
        {{> "subscribe-cta"}}
    {{/unless}}

    <nav class="post-nav">
        {{#prev_post}}
            <a class="post-nav-link post-nav-prev" href="{{url}}"><span class="post-nav-label">&larr; Previous</span><span class="post-nav-title">{{title}}</span></a>
        {{/prev_post}}
        {{#next_post}}
            <a class="post-nav-link post-nav-next" href="{{url}}"><span class="post-nav-label">Next &rarr;</span><span class="post-nav-title">{{title}}</span></a>
        {{/next_post}}
    </nav>

    {{#if comments}}
        <section class="post-comments">
            {{comments}}
        </section>
    {{/if}}
{{/post}}
