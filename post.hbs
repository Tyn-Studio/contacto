{{!< default}}

{{#post}}
    <article class="post {{post_class}}">
        <header class="post-head">
            <h1 class="post-title">{{title}}</h1>
            <p class="post-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                <span aria-hidden="true">&middot;</span>
                {{reading_time}}
                {{#if primary_tag}}
                    <span aria-hidden="true">&middot;</span>
                    <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                {{/if}}
            </p>
        </header>

        {{#if feature_image}}
            <figure class="post-feature">
                <img srcset="{{img_url feature_image size="m" format="webp"}} 800w,
                            {{img_url feature_image size="l" format="webp"}} 1200w,
                            {{img_url feature_image size="xl" format="webp"}} 2000w"
                    sizes="(min-width: 1100px) 1040px, 100vw"
                    src="{{img_url feature_image size="l" format="webp"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="eager" fetchpriority="high">
                {{#if feature_image_caption}}
                    <figcaption>{{{feature_image_caption}}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}

        {{#if access}}
            <section class="post-content gh-content">
                {{content}}
            </section>
        {{else}}
            <div class="gate">
                <p class="gate-note">This one is for subscribers. It is free.</p>
                {{> "subscribe-form"}}
                <p class="mb-signin">Already subscribed? <a href="#/portal/signin" data-portal="signin">Sign in</a></p>
            </div>
        {{/if}}
    </article>

    {{#if access}}
        {{#unless @member}}
            {{> "subscribe-cta"}}
        {{/unless}}
    {{/if}}

    {{#if primary_tag}}
        {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}" limit="3" as |related|}}
            {{#if related}}
                <section class="related">
                    <h2 class="related-label">More from {{primary_tag.name}}</h2>
                </section>
                <section class="sheet sheet--related">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </section>
            {{/if}}
        {{/get}}
    {{/if}}

    <nav class="post-nav">
        {{#prev_post}}
            <a class="post-nav-link post-nav-prev" href="{{url}}"><span class="post-nav-label">&larr; Previous</span><span class="post-nav-title">{{title}}</span></a>
        {{/prev_post}}
        {{#next_post}}
            <a class="post-nav-link post-nav-next" href="{{url}}"><span class="post-nav-label">Next &rarr;</span><span class="post-nav-title">{{title}}</span></a>
        {{/next_post}}
    </nav>

    {{#if comments}}
        <section class="post-comments">
            {{comments}}
        </section>
    {{/if}}
{{/post}}
