{{!< default}}

{{#post}}
    {{#if @member}}
        <article class="post page {{post_class}}">
            <header class="post-head">
                <h1 class="post-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="nl-intro">{{custom_excerpt}}</p>
                {{/if}}
            </header>
        </article>

        <section class="pf-grid">
            {{#get "pages" filter="tag:hash-members" limit="all" order="published_at desc"}}
                {{#foreach pages}}
                    {{> "members-card"}}
                {{else}}
                    {{#get "posts" filter="tag:hash-members" limit="1"}}
                        {{#unless posts}}
                            <p class="portfolio-empty">First goodies landing soon. You will hear about them in the newsletter.</p>
                        {{/unless}}
                    {{/get}}
                {{/foreach}}
            {{/get}}
            {{#get "posts" filter="tag:hash-members" limit="all" order="published_at desc"}}
                {{#foreach posts}}
                    {{> "members-card"}}
                {{/foreach}}
            {{/get}}
        </section>
    {{else}}
        <section class="nl-hero">
            <div class="nl-hero-media">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="l"}}" alt="" loading="eager" fetchpriority="high">
                {{else}}
                    <img src="{{img_url @site.cover_image size="l"}}" alt="" loading="eager" fetchpriority="high">
                {{/if}}
            </div>
            <div class="nl-hero-panel">
                <p class="nl-kicker">Members</p>
                <h1 class="nl-hero-title">{{title}}</h1>
                <div class="mb-benefits">
                    {{content}}
                </div>
                {{> "subscribe-form"}}
                <p class="mb-signin">Already subscribed? <a href="#/portal/signin" data-portal="signin">Sign in</a></p>
            </div>
        </section>
    {{/if}}
{{/post}}
