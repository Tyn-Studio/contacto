{{!< default}}

{{#post}}
    <article class="post page {{post_class}}">
        <header class="post-head post-head--edge">
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="portfolio-intro">{{custom_excerpt}}</p>
            {{/if}}
        </header>
    </article>
{{/post}}

{{!-- Series are pages tagged #portfolio plus one of #street, #travel or
      #nature. A series without a category still shows, under "More". --}}
{{#get "pages" filter="tag:hash-portfolio+tag:hash-street" limit="all" order="published_at desc"}}
    {{#if pages}}
        <section class="pf-section" id="street">
            <header class="pf-section-head">
                <h2 class="pf-section-title">Street</h2>
                <p class="pf-section-intro">Amsterdam, mostly: people, bicycles and light.</p>
            </header>
            <div class="pf-grid">
                {{#foreach pages}}{{> "pf-card"}}{{/foreach}}
            </div>
        </section>
    {{/if}}
{{/get}}
{{#get "pages" filter="tag:hash-portfolio+tag:hash-travel" limit="all" order="published_at desc"}}
    {{#if pages}}
        <section class="pf-section" id="travel">
            <header class="pf-section-head">
                <h2 class="pf-section-title">Travel</h2>
                <p class="pf-section-intro">Trips near and far.</p>
            </header>
            <div class="pf-grid">
                {{#foreach pages}}{{> "pf-card"}}{{/foreach}}
            </div>
        </section>
    {{/if}}
{{/get}}
{{#get "pages" filter="tag:hash-portfolio+tag:hash-nature" limit="all" order="published_at desc"}}
    {{#if pages}}
        <section class="pf-section" id="nature">
            <header class="pf-section-head">
                <h2 class="pf-section-title">Nature</h2>
                <p class="pf-section-intro">Dunes, parks and gardens around home.</p>
            </header>
            <div class="pf-grid">
                {{#foreach pages}}{{> "pf-card"}}{{/foreach}}
            </div>
        </section>
    {{/if}}
{{/get}}
{{#get "pages" filter="tag:hash-portfolio+tag:-hash-street+tag:-hash-travel+tag:-hash-nature" limit="all" order="published_at desc"}}
    {{#if pages}}
        <section class="pf-section" id="more">
            <header class="pf-section-head"><h2 class="pf-section-title">More</h2></header>
            <div class="pf-grid">
                {{#foreach pages}}{{> "pf-card"}}{{/foreach}}
            </div>
        </section>
    {{/if}}
{{/get}}
