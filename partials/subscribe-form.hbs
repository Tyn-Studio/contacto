<form class="signup" data-members-form="signup">
    <div class="signup-row">
        <input class="signup-email" type="email" name="email" data-members-email
            placeholder="your@email.com" required aria-label="Your email address">
        <button class="signup-btn" type="submit">
            <span class="signup-btn-default">Subscribe</span>
            <span class="signup-btn-loading">Sending&hellip;</span>
        </button>
    </div>
    <p class="signup-note">{{@custom.signup_disclaimer}}</p>
    <p class="signup-success">Check your inbox and click the link to confirm.</p>
    <p class="signup-error" data-members-error></p>
</form>
