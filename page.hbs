{{!< default}}

{{#post}}
    {{#has tag="#portfolio"}}
        <article class="post gallery {{post_class}}">
            <header class="post-head post-head--edge gallery-head">
                <h1 class="post-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="gallery-intro">{{custom_excerpt}}</p>
                {{/if}}
            </header>

            {{!-- filled by gallery.js from the images below; without JS the
                  images simply render as normal page content --}}
            <div class="gallery-viewer" hidden>
                <div class="gv-stage">
                    <button class="gv-prev" type="button" aria-label="Previous photo">&larr;</button>
                    <img class="gv-img" alt="">
                    <button class="gv-next" type="button" aria-label="Next photo">&rarr;</button>
                </div>
                <p class="gv-count"><span class="gv-index">1</span> / <span class="gv-total"></span></p>
            </div>

            <section class="gallery-source post-content gh-content">
                {{content}}
            </section>

            <p class="gallery-back"><a href="{{@site.url}}/portfolio/">&larr; Portfolio</a></p>
        </article>
    {{else}}
    <article class="post page {{post_class}}">
        {{#match @page.show_title_and_feature_image}}
            <header class="post-head">
                <h1 class="post-title">{{title}}</h1>
            </header>

            {{#if feature_image}}
                <figure class="post-feature">
                    <img srcset="{{img_url feature_image size="m"}} 800w,
                                {{img_url feature_image size="l"}} 1200w"
                        sizes="(min-width: 1100px) 1040px, 100vw"
                        src="{{img_url feature_image size="l"}}"
                        alt="{{title}}" loading="eager" fetchpriority="high">
                </figure>
            {{/if}}
        {{/match}}

        {{#if access}}
            <section class="post-content gh-content">
                {{content}}
            </section>
        {{else}}
            <div class="gate">
                <p class="gate-note">This page is for subscribers. It is free.</p>
                {{> "subscribe-form"}}
                <p class="mb-signin">Already subscribed? <a href="#/portal/signin" data-portal="signin">Sign in</a></p>
            </div>
        {{/if}}
    </article>
    {{/has}}
{{/post}}
